---
import Header from './Header.astro';
import NetworkGraph from './NetworkGraph.astro';
import Inspector from './Inspector.astro';
import InfoPanel from './InfoPanel.astro';
import ControlPanel from './ControlPanel.astro';
import StatsPanel from './StatsPanel.astro';
import EventLog from './EventLog.astro';

const tabs = [
  { tab: 'controls', label: 'Controls' },
  { tab: 'stats', label: 'Telemetry' },
  { tab: 'log', label: 'Log' },
];
---
<main class="app-shell flex h-dvh min-h-dvh flex-col overflow-hidden">
  <Header />

  <section aria-label="Network simulator" class="relative min-h-0 flex-1">
    <NetworkGraph />
    <Inspector />
    <InfoPanel />
  </section>

  <footer class="dock shrink-0 border-t border-slate-800 bg-slate-950">
    <nav class="tab-bar grid shrink-0 grid-cols-3 border-b border-slate-800 lg:hidden" aria-label="Panels">
      {
        tabs.map((t) => (
          <button
            class="tab-btn border-b-2 border-transparent px-3 py-2.5 font-mono text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-500 transition hover:text-slate-300"
            type="button"
            role="tab"
            aria-selected={t.tab === 'controls'}
            aria-controls={`panel-${t.tab}`}
            data-tab={t.tab}
          >
            {t.label}
          </button>
        ))
      }
    </nav>
    <div class="dock-body grid min-h-0 grid-cols-1 lg:h-full lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)_minmax(0,0.9fr)] lg:gap-0 lg:divide-x lg:divide-slate-800">
      <div id="panel-controls" class="tab-panel is-active" data-tab="controls" role="tabpanel">
        <ControlPanel />
      </div>
      <div id="panel-stats" class="tab-panel" data-tab="stats" role="tabpanel">
        <StatsPanel />
      </div>
      <div id="panel-log" class="tab-panel" data-tab="log" role="tabpanel">
        <EventLog />
      </div>
    </div>
  </footer>
</main>

<script>
  import '../lib/app';
</script>