---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
}
const { title = 'PACKET LAB — Packet Switching Simulator', description = 'Interactive educational tool that visualizes how packet switching works across a network.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#020617" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-dvh overflow-hidden">
    <slot />
  </body>
</html>